# Copy this file to .env and fill in ONE provider. .env is git-ignored.

# --- Option A: Groq (free tier) ---------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: Google Gemini (free tier) -------------------------------------
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# --- Option C: Anthropic Claude ----------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# --- Option D: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together...) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=

# --- Option E: local Ollama (no key) -----------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# Tuning (optional)
# FULL_CONTEXT_CHARS=60000   # chats smaller than this are sent whole; larger ones use retrieval
